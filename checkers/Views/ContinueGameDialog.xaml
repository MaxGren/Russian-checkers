<Window x:Class="checkers.Views.ContinueGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Незавершённая партия"
        Width="440"
        Height="220"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="У вас есть незавершённая партия.&#10;Хотите продолжить игру?"
                   FontSize="16"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>


        <UniformGrid Grid.Row="1"
             Rows="2"
             Columns="2"
             Margin="0,15,0,0">

            <Button Content="Продолжить"
            Height="38"
            Margin="3"
            Click="Continue_Click"/>

            <Button Content="Новая игра"
            Height="38"
            Margin="3"
            Click="NewGame_Click"/>

            <Button Content="Завершить игру"
            Height="38"
            Margin="3"
            Click="FinishGame_Click"/>

            <Button Content="Позже"
            Height="38"
            Margin="3"
            Click="Later_Click"/>

        </UniformGrid>

    </Grid>
</Window>
