<Window x:Class="checkers.Views.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Русские шашки — Главное меню"
        Height="550"
        Width="420"
        MinHeight="550"
        MinWidth="420"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="35">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="РУССКИЕ ШАШКИ"
                       FontSize="26"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,15"/>

            <TextBlock x:Name="WelcomeText"
                       FontSize="15"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>



            <TextBlock Text="Сложность компьютера:"
                       FontSize="14"
                       Margin="0,0,0,7"/>

            <ComboBox x:Name="DifficultyComboBox"
                      Height="35"
                      SelectedIndex="0"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Лёгкая"/>
                <ComboBoxItem Content="Средняя"/>
                <ComboBoxItem Content="Сложная"/>
            </ComboBox>


            <Button Content="Новая игра"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="NewGameButton_Click"/>

            <Button Content="Продолжить игру"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="ContinueGameButton_Click"/>

            <Button Content="История партий"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="HistoryButton_Click"/>

            <Button Content="Выйти из аккаунта"
                    Height="40"
                    Click="LogoutButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
