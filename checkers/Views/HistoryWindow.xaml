<Window x:Class="checkers.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История партий — Русские шашки"
        Width="850"
        Height="600"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="История партий"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1"
                  x:Name="GamesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  SelectionChanged="GamesDataGrid_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="55"/>

                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding StartedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="145"/>

                <DataGridTextColumn Header="Результат"
                                    Binding="{Binding ResultText}"
                                    Width="*"/>

                <DataGridTextColumn Header="Цвет"
                                    Binding="{Binding ColorText}"
                                    Width="*"/>

                <DataGridTextColumn Header="Сложность"
                                    Binding="{Binding DifficultyText}"
                                    Width="*"/>

                <DataGridTextColumn Header="Ходов"
                                    Binding="{Binding MoveCount}"
                                    Width="75"/>

            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Text="Ходы выбранной партии"
                   FontSize="17"
                   FontWeight="Bold"
                   Margin="0,18,0,10"/>

        <ListBox Grid.Row="3"
                    x:Name="MovesList"/>

        <Button Grid.Row="4"
                Content="Сохранить протокол в TXT"
                Width="210"
                Height="38"
                HorizontalAlignment="Left"
                Margin="0,15,0,0"
                Click="ExportProtocolButton_Click"/>

        <Button Grid.Row="4"
                Content="Закрыть"
                Height="38"
                Width="130"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Click="CloseButton_Click"/>

    </Grid>
</Window>
